# 数据库连接（PostgreSQL 协议）。
# 国产数据库（人大金仓 KingbaseES / OceanBase / 达梦 PG 模式）大多兼容 PG 线协议，
# 未来替换为国产库时，仅需修改下方 DATABASE_URL 与安装对应 pg 兼容驱动，业务代码零改动。
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/material_manager

# JWT 密钥，生产环境务必修改
JWT_SECRET=material-manager-demo-secret

# 后端监听端口
PORT=4000

# 允许的前端跨域来源（开发默认 5173）
CORS_ORIGIN=http://localhost:5173
